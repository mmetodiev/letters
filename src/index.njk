---
permalink: /index.html
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ site.title }}</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>

<a class="account-link" href="/account/" aria-label="Account">
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
    <path fill="currentColor" d="M12 12a4.5 4.5 0 1 0-4.5-4.5A4.5 4.5 0 0 0 12 12zm0 2.25c-3.6 0-6.75 1.8-6.75 4.05V20h13.5v-1.7c0-2.25-3.15-4.05-6.75-4.05z"/>
  </svg>
</a>

<div class="book-header home-header">
  <h1>{{ site.title }}</h1>
  <p class="subtitle">{{ site.subtitle }}</p>
  <p class="home-meta">{{ collections.letters | length }} letters · modern English</p>
</div>

<nav class="home-actions" aria-label="Primary">
  <a class="home-cta" href="/letters/">Read the letters</a>
  <a class="home-cta home-cta-secondary" href="/saved/">Saved</a>
</nav>

<p class="home-start">
  Or begin with
  {% set first = collections.letters | letterByNum(1) %}
  <a href="{{ first.url }}">{{ first.data.title }}</a>.
</p>

<p class="home-about">
  <a href="/about/">About this project</a>
</p>

</body>
</html>
