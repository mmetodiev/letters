<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Saved – {{ site.title }}</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>

<a class="account-link" href="/account/" aria-label="Account">
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
    <path fill="currentColor" d="M12 12a4.5 4.5 0 1 0-4.5-4.5A4.5 4.5 0 0 0 12 12zm0 2.25c-3.6 0-6.75 1.8-6.75 4.05V20h13.5v-1.7c0-2.25-3.15-4.05-6.75-4.05z"/>
  </svg>
</a>

<nav class="site-breadcrumbs" aria-label="Breadcrumb">
  <ol>
    <li><a href="/">Home</a></li>
    <li aria-current="page">Saved</li>
  </ol>
</nav>

<div class="book-header">
  <h1>Saved</h1>
  <p class="intro">Letters you’ve saved, newest first. Notes live with each letter.</p>
</div>

<div data-saved-root>
  <p class="saved-empty" data-saved-empty>Nothing saved yet. Open a letter and tap Save, or start a note.</p>
  <ul class="saved-list" data-saved-list hidden></ul>
</div>

<section class="data-transfer" aria-labelledby="transfer-heading">
  <h2 id="transfer-heading" class="section-label">Backup</h2>
  <p class="transfer-help">Export or import your saved letters and notes as JSON (stays on your device).</p>
  <div class="transfer-actions">
    <button type="button" class="transfer-btn" data-export>Export</button>
    <label class="transfer-btn transfer-btn-secondary">
      Import
      <input type="file" accept="application/json,.json" data-import hidden>
    </label>
  </div>
</section>

<script type="application/json" id="letter-catalog">
[
{%- for item in collections.letters -%}
  {"path":"{{ item.url }}","title":{{ item.data.title | dump | safe }}}{% if not loop.last %},{% endif %}
{%- endfor -%}
]
</script>
<script src="/user-data.js" defer></script>
</body>
</html>
