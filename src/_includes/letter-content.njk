<nav class="site-breadcrumbs" aria-label="Breadcrumb">
  <ol>
    <li><a href="/">Home</a></li>
    <li><a href="/letters/">Letters</a></li>
    <li aria-current="page">{{ title | truncate(48) }}</li>
  </ol>
</nav>

<header class="letter-header">
  <h1>{{ title }}</h1>
  <button type="button" class="save-btn" data-save-toggle aria-pressed="false">
    Save
  </button>
</header>

<div class="letter-prose">
{{ content | safe }}
</div>

<section class="letter-notes" aria-labelledby="notes-heading">
  <h2 id="notes-heading" class="section-label">Your notes</h2>
  <textarea
    class="notes-textarea"
    data-notes-input
    rows="5"
    placeholder="Write a note — this letter is saved automatically…"
  ></textarea>
</section>

<nav class="letter-footer" aria-label="Letter navigation">
  <a href="/letters/">All letters</a>
</nav>
